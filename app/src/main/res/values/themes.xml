<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose draws everything, so this only needs to cover the splash window.
      The colour matches Palette.Paper so there is no flash before first frame.
    -->
    <style name="Theme.SipPlanner" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
